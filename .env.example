# Environment variables (copy into `.env` — do not commit secrets)

# PostgreSQL (local Docker Compose default — see docker-compose.yml)
DATABASE_URL="postgresql://ttgordon:ttgordon@127.0.0.1:5432/ttgordon?schema=public"

# On Railway, set instead:
# DATABASE_URL=${{Postgres.DATABASE_URL}}

AUTH_SECRET="change-me-in-production"

# Google Maps — enable in Google Cloud Console:
# 1. Maps JavaScript API (required for /rentals Map View)
# 2. Geocoding API (optional; owner portal "Geocode address")
# Restrict the browser key to your domain (localhost + Railway URL).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional server-only Geocoding key (falls back to NEXT_PUBLIC_ if unset)
# GOOGLE_MAPS_API_KEY=
